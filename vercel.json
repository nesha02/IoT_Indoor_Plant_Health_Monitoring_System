{
  "version": 2,
  "builds": [
    { "src": "client/index.html", "use": "@vercel/static-build", "config": { "distDir": "dist/spa" } },
    { "src": "api/index.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/(.*)", "dest": "/dist/spa/index.html" }
  ]
}
